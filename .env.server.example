# ─── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (the frontend dev + prod URLs)
CORS_ORIGINS=http://localhost:5173

# ─── Database (Prisma) ────────────────────────────────────────────────────
# Pooled connection (PgBouncer) — used at runtime
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?pgbouncer=true"
# Direct connection — used by `prisma db pull` / migrations
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

# ─── Auth (Supabase JWT verification — Phase 1) ───────────────────────────
# The project's JWT secret (Supabase dashboard → Settings → API → JWT Secret).
# Used to verify the HS256 access token the frontend sends as `Authorization: Bearer <token>`.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
# Expected `aud` claim on Supabase access tokens (default "authenticated").
SUPABASE_JWT_AUD=authenticated
